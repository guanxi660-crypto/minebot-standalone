# ============================================
# 面板环境变量 —— 仅面板自身需要, 其余模块配置见各自文件
# 复制此文件为 .env 并修改:
#   cp .env.sample .env
#
# ⚠️ core (代理) 与 status (监控) 的配置不在这里,
#    请直接编辑项目根目录的 core 和 status 文件「配置区」。
# ============================================

# --------------------------------------------
# 面板
# --------------------------------------------

# 监听端口 (默认 4681)
# 优先级: SERVER_PORT > PORT > 4681
# Pterodactyl 部署时设为面板分配的外部端口
PORT=4681
# SERVER_PORT=4681

# 面板登录账号 (默认 admin / admin123)
# 首次登录后请务必修改!
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --------------------------------------------
# 面板运行参数
# --------------------------------------------

# 内存自动关闭阈值 (%)
# 进程 RSS 超过此百分比时会触发优雅关闭 (设为 0 禁用)
MEMORY_MAX_PERCENT=90

# 覆盖系统检测到的内存限制 (单位 MB)
# 不设置则自动检测 cgroup 或系统总内存
# SERVER_MEMORY=1024

# 自动补装依赖 (设为 0 关闭)
AUTO_FIX_DEPS=1

# --------------------------------------------
# 模块开关 ( 覆盖模块文件内的默认值 )
# --------------------------------------------
# 详细配置请编辑对应模块文件的「配置区」:
#   core   → 代理核心 ( 端口 / UUID / 隧道 / 订阅 / 推送 )
#   status → 监控上报 ( 哪吒地址 / 密钥 )
#
# 下面两项通常无需改动, 环境变量优先级高于文件内配置。
# CORE_ENABLED=true      # 代理核心总开关
# STATUS_ENABLED=true    # 监控上报总开关
