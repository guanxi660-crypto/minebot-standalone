# ============================================
# 面板环境变量 (.env)
# ------------------------------------------------------------
# 复制此文件为 .env 后按需修改:
#   cp .env.sample .env
#
# 【本文件只管面板】
#   代理核心与监控上报的参数不在这里, 请直接编辑项目根目录的
#   core / status 两个文件的「配置区」(改等号右侧的值即可)。
# ============================================

# --------------------------------------------
# 面板监听
# --------------------------------------------

# 监听端口 (代码默认 4681)
# 取值优先级: SERVER_PORT > PORT > 4681
# Pterodactyl / 翼龙面板: 填面板分配给你的外部端口
PORT=4681
# SERVER_PORT=4681

# 面板登录账号 (默认 admin / admin123)
# ⚠️ 首次部署后请立即修改
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --------------------------------------------
# 面板运行参数
# --------------------------------------------

# 内存硬阈值 (占限制内存的百分比)
# 超过此值触发优雅关闭, 由面板自动重启拉起
# 设为 0 禁用该保护
MEMORY_MAX_PERCENT=90

# 覆盖自动检测到的内存上限 (单位 MB)
# 容器内检测不准时可手动指定; 留空则自动读 cgroup
# SERVER_MEMORY=1024

# 启动时自动补装缺失的依赖 (设为 0 关闭)
AUTO_FIX_DEPS=1

# --------------------------------------------
# 模块总开关
# --------------------------------------------
# 默认都是 false —— 只跑挂机面板, 不启动任何附加模块。
# 想要某个模块时, 先完成这两步, 再把对应开关改成 true:
#
#   1. 上传该模块文件到项目根目录 (与 index.js 同级):
#        core    —— 代理核心, 文件名没有扩展名
#        status  —— 监控上报, 文件名没有扩展名
#        两个文件缺失时面板照常运行, 只是该模块被跳过。
#
#   2. 打开该文件, 编辑顶部「配置区」, 填好参数并保存。
#        (例如 core 里填端口/UUID/隧道, status 里填哪吒地址与密钥)
#
# 开关说明:
#   CORE_ENABLED   代理核心 —— VMess / Reality / Hysteria2 / TUIC / AnyTLS / SOCKS5 + Argo 隧道
#   STATUS_ENABLED 监控上报 —— 哪吒 v1 指标上报 (CPU/内存/磁盘/网络)
#
# 优先级: 这里的环境变量 > 模块文件内的配置值
CORE_ENABLED=false
STATUS_ENABLED=false
