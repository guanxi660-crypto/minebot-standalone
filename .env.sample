# ============================================
# 面板环境变量 (.env)
# ------------------------------------------------------------
# 复制此文件为 .env 后按需修改:
#   cp .env.sample .env
#
# dev 版为纯挂机面板, 不含代理核心(core)与状态上报(status)模块,
# 无需配置任何模块参数。
# ============================================

# --------------------------------------------
# 面板监听
# --------------------------------------------

# 监听端口 (代码默认 4681)
# 取值优先级: SERVER_PORT > PORT > 4681
# Docker 部署: 容器内固定监听 4681, 用 -p 映射外部端口
PORT=4681
# SERVER_PORT=4681

# 面板登录账号 (默认 admin / admin123)
# ⚠️ 首次部署后请立即修改
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --------------------------------------------
# 面板运行参数
# --------------------------------------------

# 内存硬阈值 (占限制内存的百分比)
# 超过此值触发优雅关闭, 由面板自动重启拉起
# 设为 0 禁用该保护
MEMORY_MAX_PERCENT=90

# 覆盖自动检测到的内存上限 (单位 MB)
# 容器内检测不准时可手动指定; 留空则自动读 cgroup
# SERVER_MEMORY=1024

# 启动时自动补装缺失的依赖 (设为 0 关闭)
AUTO_FIX_DEPS=1

