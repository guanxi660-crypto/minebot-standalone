# ============================================
# MineCraft Bot Assistant + 原生核心服务 + 哪吒监控 - 环境变量配置
# 复制此文件为 .env 并修改:
#   cp .env.example .env
# ============================================

# --------------------------------------------
# 面板
# --------------------------------------------

# 监听端口 (默认 4681)
# 优先级: SERVER_PORT > PORT > 4681
# Pterodactyl 部署时设为面板分配的外部端口
PORT=4681
# SERVER_PORT=4681

# 面板登录账号 (默认 admin / admin123)
# 首次登录后请务必修改!
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# 面板访问: http://<IP>:<PORT>/  (根路径即面板登录页)

# --------------------------------------------
# 面板运行参数
# --------------------------------------------

# 内存自动关闭阈值 (%)
# 进程 RSS 超过此百分比时会触发优雅关闭 (设为 0 禁用)
MEMORY_MAX_PERCENT=90

# 覆盖系统检测到的内存限制 (单位 MB)
# 不设置则自动检测 cgroup 或系统总内存
# SERVER_MEMORY=1024

# 自动补装依赖 (设为 0 关闭)
AUTO_FIX_DEPS=1

# --------------------------------------------
# 原生核心服务 core (端口全部留空 = 不启用, 只跑面板)
# --------------------------------------------

# 核心服务总开关 (true=随进程自动启动 / false=关闭后可在面板手动开启)
CORE_ENABLED=true

# 订阅路径 (http://<IP>:<PORT>/<SUB_PATH>)
SUB_PATH=sub

# 节点 UUID (建议自行修改)
UUID=0a6568ff-ea3c-4271-9020-450560e10d63

# 节点名称前缀 (留空则用 IP-ISP 自动命名)
NAME=

# 入站端口 (留空 = 不启用该协议)
# S5_PORT=1234        # SOCKS5
# HY2_PORT=8443       # Hysteria2
# TUIC_PORT=9443      # TUIC
# ANYTLS_PORT=10443   # AnyTLS
# REALITY_PORT=14443  # VLESS Reality

# Argo 固定隧道 (两个都填才用固定隧道, 否则用临时隧道)
# ARGO_DOMAIN=example.your-domain.com
# ARGO_AUTH=你的 tunnel token 或 TunnelSecret JSON
ARGO_PORT=8001
# DISABLE_ARGO=true   # 设为 true 禁用隧道

# 优选域名/IP (VMess 节点用)
CFIP=saas.sin.fan
CFPORT=443

# 运行目录 (存放动态库/配置/订阅, 默认 .npm)
# 注意: 该目录会被核心服务自动清理, 不要往里放需要长期保留的文件
FILE_PATH=.npm

# Telegram 推送 (两个都填才推送)
# CHAT_ID=
# BOT_TOKEN=

# 订阅自动上传 (需另部署 Merge-sub)
# UPLOAD_URL=
# PROJECT_URL=
# AUTO_ACCESS=false

# 视频站点强制走 WARP 出站
YT_WARPOUT=false

# 核心服务日志开关 (false 屏蔽)
SHOW_LOG=true

# --------------------------------------------
# 哪吒监控上报 status.js (与上面核心服务相互独立)
# --------------------------------------------
# 不填 NEZHA_SERVER / NEZHA_KEY = 不启用, 面板完全不受影响

# 监控上报总开关 (true=按下方配置决定 / false=强制关闭上报)
STATUS_ENABLED=true

# 哪吒 v1 面板地址, 形如 "host:port" (v1 的 gRPC 端口, 不是网页 HTTP 端口)
# NEZHA_SERVER=nz.serv00.net:8008
# 面板客户端设置里生成的 Client Secret
# NEZHA_KEY=
# 与面板中登记一致的 Client UUID (上面的 UUID 复用同一值)
# 设为 1 打开哪吒详细日志 (排障用)
# SHOW_LOG=1
