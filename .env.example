# ============================================
# MineCraft Bot Assistant - 环境变量配置
# 复制此文件为 .env 并修改:
#   cp .env.example .env
# ============================================

# 监听端口 (默认 4681)
# 优先级: SERVER_PORT > PORT > 4681
# Pterodactyl 部署时设为面板分配的外部端口
PORT=3215
# SERVER_PORT=4681

# 内存自动关闭阈值 (%)
# 进程 RSS 超过此百分比时会触发优雅关闭 (设为 0 禁用)
MEMORY_MAX_PERCENT=90

# 覆盖系统检测到的内存限制 (单位 MB)
# 不设置则自动检测 cgroup 或系统总内存
# SERVER_MEMORY=1024

# 自动补装依赖 (设为 0 关闭)
AUTO_FIX_DEPS=1

# 面板登录账号 (默认 admin / admin123)
# 首次登录后请务必修改!
ADMIN_USER=admin
ADMIN_PASSWORD=admin123