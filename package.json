{
  "name": "minebot-standalone",
  "version": "1.0.0",
  "private": true,
  "description": "MineCraft Bot Assistant - dev (Linux VPS 纯挂机面板, 无代理/上报模块)",
  "main": "index.js",
  "scripts": {
