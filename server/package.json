{
  "name": "minebot-server",
  "version": "1.0.0",
  "description": "Minecraft Bot Backend Server",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop minebot",
    "pm2:restart": "pm2 restart minebot",
    "pm2:logs": "pm2 logs minebot",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "minecraft-protocol": "latest",
    "mineflayer": "latest",
    "mineflayer-pathfinder": "latest",
    "openai": "^4.20.0",
    "proxy-chain": "^2.7.0",
    "rcon-client": "^4.2.5",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "ssh2-sftp-client": "^12.0.1",
    "ws": "^8.14.2"
  }
}
