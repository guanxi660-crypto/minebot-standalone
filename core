function tunnelPayload() {
  if (DISABLE_ARGO === 'true' || DISABLE_ARGO === true) return null;
  if (ARGO_AUTH && ARGO_DOMAIN) {
    if (ARGO_AUTH.match(/^[A-Z0-9a-z=]{120,250}$/)) {
      return JSON.stringify({
        args: ['tunnel', '--edge-ip-version', 'auto', '--no-autoupdate', '--protocol', 'http2', 'run', '--token', ARGO_AUTH]
      });
    } else if (ARGO_AUTH.match(/TunnelSecret/)) {
      return JSON.stringify({
        args: ['tunnel', '--edge-ip-version', 'auto', '--config', path.join(FILE_PATH, 'tunnel.yml'), 'run']
      });
    }
  }
  // 临时隧道
  return JSON.stringify({
    args: [
      'tunnel', '--edge-ip-version', 'auto', '--no-autoupdate',
      '--protocol', 'http2', '--logfile', bootLogPath,
      '--loglevel', 'info', '--url', `http://localhost:${ARGO_PORT}`
    ]
  });
}

function corePayload() {
  return JSON.stringify({ config: singBoxConfigPath, workingDir: '.', disableColor: true });
}

// ======================== 隧道域名检测 ========================

function waitForTunnelDomain(logPath, timeoutMs) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    try {
      if (fs.existsSync(logPath)) {
        const content = fs.readFileSync(logPath, 'utf8');
        const matches = [...content.matchAll(/https:\/\/([A-Za-z0-9.-]+\.trycloudflare\.com)/g)];
        if (matches.length > 0) {
          return matches[matches.length - 1][1];
        }
      }
    } catch (e) { /* file may not exist yet */ }
    const remaining = deadline - Date.now();
    if (remaining <= 0) break;
    const sleepMs = Math.min(1000, remaining);
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, sleepMs);
  }
  return null;
}

async function extractDomain() {
  if (DISABLE_ARGO === 'true' || DISABLE_ARGO === true) return null;
  if (ARGO_AUTH && ARGO_DOMAIN) {
    return ARGO_DOMAIN;
  }
  // 临时隧道: 从日志里取域名
  let domain = waitForTunnelDomain(bootLogPath, 30000);
  if (!domain) {
    try { fs.unlinkSync(bootLogPath); } catch (e) { }
    await new Promise(r => setTimeout(r, 5000));
    domain = waitForTunnelDomain(bootLogPath, 30000);
  }
  return domain;
}

// ======================== ISP 信息 ========================

async function getMetaInfo() {
  try {
    const response1 = await axios.get('https://api.ip.sb/geoip', { headers: { 'User-Agent': 'Mozilla/5.0', timeout: 3000 } });
    if (response1.data && response1.data.country_code && response1.data.isp) {
      return `${response1.data.country_code}-${response1.data.isp}`.replace(/\s+/g, '_');
    }
  } catch (error) {
    try {
      const response2 = await axios.get('http://ip-api.com/json', { headers: { 'User-Agent': 'Mozilla/5.0', timeout: 3000 } });
      if (response2.data && response2.data.status === 'success' && response2.data.countryCode && response2.data.org) {
        return `${response2.data.countryCode}-${response2.data.org}`.replace(/\s+/g, '_');
      }
    } catch (error) { /* backup also failed */ }
  }
  return 'Unknown';
}

// ======================== 节点链接生成 ========================

async function generateLinks(argoDomain) {
  let SERVER_IP = '';
  try {
    const ipv4Response = await axios.get('http://ipv4.ip.sb', { timeout: 3000 });
    SERVER_IP = ipv4Response.data.trim();
  } catch (err) {
    try {
      SERVER_IP = execSync('curl -sm 3 ipv4.ip.sb').toString().trim();
    } catch (curlErr) {
      try {
        const ipv6Response = await axios.get('http://ipv6.ip.sb', { timeout: 3000 });
        SERVER_IP = `[${ipv6Response.data.trim()}]`;
      } catch (ipv6AxiosErr) {
        try {
          SERVER_IP = `[${execSync('curl -sm 3 ipv6.ip.sb').toString().trim()}]`;
        } catch (ipv6CurlErr) {
          log('Failed to get public IP');
        }
      }
    }
  }

  const ISP = await getMetaInfo();
  const nodeName = NAME ? `${NAME}-${ISP}` : ISP;

  await new Promise(r => setTimeout(r, 2000));

  let subTxt = '';

  // VMess+WS (隧道)
  if ((DISABLE_ARGO !== 'true' && DISABLE_ARGO !== true) && argoDomain) {
    const vmessNode = `vmess://${Buffer.from(JSON.stringify({ v: '2', ps: `${nodeName}`, add: CFIP, port: CFPORT, id: UUID, aid: '0', scy: 'auto', net: 'ws', type: 'none', host: argoDomain, path: '/vmess-argo?ed=2560', tls: 'tls', sni: argoDomain, alpn: '', fp: 'firefox' })).toString('base64')}`;
    subTxt = vmessNode;
  }

  // TUIC
  if (isValidPort(TUIC_PORT)) {
    subTxt += `\ntuic://${UUID}:${UUID}@${SERVER_IP}:${TUIC_PORT}?sni=www.bing.com&congestion_control=bbr&udp_relay_mode=native&alpn=h3&allow_insecure=1#${nodeName}`;
  }

  // Hysteria2
  if (isValidPort(HY2_PORT)) {
    subTxt += `\nhysteria2://${UUID}@${SERVER_IP}:${HY2_PORT}/?sni=www.bing.com&insecure=1&alpn=h3&obfs=none#${nodeName}`;
  }

  // Reality
  if (isValidPort(REALITY_PORT)) {
    subTxt += `\nvless://${UUID}@${SERVER_IP}:${REALITY_PORT}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.iij.ad.jp&fp=firefox&pbk=${publicKey}&type=tcp&headerType=none#${nodeName}`;
  }

  // AnyTLS
  if (isValidPort(ANYTLS_PORT)) {
    subTxt += `\nanytls://${UUID}@${SERVER_IP}:${ANYTLS_PORT}?security=tls&sni=${SERVER_IP}&fp=chrome&insecure=1&allowInsecure=1#${nodeName}`;
  }

  // SOCKS5
  if (isValidPort(S5_PORT)) {
    const S5_AUTH = Buffer.from(`${UUID.substring(0, 8)}:${UUID.slice(-12)}`).toString('base64');
    subTxt += `\nsocks://${S5_AUTH}@${SERVER_IP}:${S5_PORT}#${nodeName}`;
  }

  // 订阅落盘 (明文列表仅本地临时留存, 随后清理)
  fs.writeFileSync(subPath, Buffer.from(subTxt).toString('base64'));
  fs.writeFileSync(listPath, subTxt, 'utf8');
  log(`Subscription saved (${subTxt.split('\n').filter(Boolean).length} nodes)`);

  return subTxt;
}

// ======================== Telegram 推送 ========================

async function sendTelegram() {
  if (!BOT_TOKEN || !CHAT_ID) {
    log('Notify credentials not set, skipping push');
    return;
  }
  try {
    const message = fs.readFileSync(subPath, 'utf8');
    const url = `https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`;
    const escapedName = (NAME || 'Node').replace(/[_*[\]()~`>#+=|{}.!-]/g, '\\$&');
    const params = {
      chat_id: CHAT_ID,
      text: `**${escapedName}节点推送通知**\n\`\`\`${message}\`\`\``,
      parse_mode: 'MarkdownV2'
    };
    await axios.post(url, null, { params });
    log('Notification sent');
  } catch (error) {
    log('Failed to send notification:', error.message);
  }
}

// ======================== 节点上传 ========================

async function uploadNodes() {
  if (UPLOAD_URL && PROJECT_URL) {
    const subscriptionUrl = `${PROJECT_URL}/${SUB_PATH}`;
    const jsonData = { subscription: [subscriptionUrl] };
    try {
      const response = await axios.post(`${UPLOAD_URL}/api/add-subscriptions`, jsonData, {
        headers: { 'Content-Type': 'application/json' }
      });
      if (response.status === 200) log('Subscription uploaded successfully');
    } catch (error) { /* ignore */ }
  } else if (UPLOAD_URL) {
    if (!fs.existsSync(listPath)) return;
    const content = fs.readFileSync(listPath, 'utf-8');
    const nodes = content.split('\n').filter(line => /(vless|vmess|trojan|hysteria2|tuic):\/\//.test(line));
    if (nodes.length === 0) return;
    try {
      const response = await axios.post(`${UPLOAD_URL}/api/add-nodes`,
        JSON.stringify({ nodes }),
        { headers: { 'Content-Type': 'application/json' } }
      );
      if (response.status === 200) log('Nodes uploaded successfully');
    } catch (error) { /* ignore */ }
  }
}

// ======================== 自动保活 ========================

async function addVisitTask() {
  if (!AUTO_ACCESS || !PROJECT_URL) {
    log('Keepalive not configured, skipping');
    return;
  }
  try {
    await axios.post('https://keep.gvrander.eu.org/add-url', {
      url: PROJECT_URL
    }, { headers: { 'Content-Type': 'application/json' } });
    log('Keepalive task added');
  } catch (error) {
    log(`Keepalive failed: ${error.message}`);
  }
}

// ======================== 对外接口 ========================

let currentSubTxt = '';

/**
 * 启动全部原生服务
 * @returns {Promise<{subTxt: string, argoDomain: string|null}>}
 */
async function startSbx() {
  if (started) return { subTxt: currentSubTxt, argoDomain: null };
  started = true;
  coreState = 'starting';

  try {
    // 1. 删除旧节点
    deleteNodes();

    // 2. 创建运行目录 + 清理旧文件
    if (!fs.existsSync(FILE_PATH)) {
      fs.mkdirSync(FILE_PATH);
    }
    cleanupOldFiles();

    // 3. 生成隧道配置
    argoType();

    // 4. 下载原生库 (URL 用真名, 本地用伪装名)
    const coreLib = await downloadLibrary(LIB.core.url, LIB.core.local);
    let tunnelLib = null;

    if (DISABLE_ARGO !== 'true' && DISABLE_ARGO !== true) {
      tunnelLib = await downloadLibrary(LIB.tunnel.url, LIB.tunnel.local);
    }

    // 5. Reality 密钥对
    if (REALITY_PORT) {
      generateOrLoadKeyPair();
    }

    // 6. TLS 证书
    const certPath = path.join(FILE_PATH, 'cert.pem');
    const keyPath = path.join(FILE_PATH, 'private.key');
    const needsTls = !!(HY2_PORT || TUIC_PORT || ANYTLS_PORT);
    if (needsTls) {
      ensureTlsCertificates(certPath, keyPath);
    }

    // 7. 内核配置
    const coreConfig = generateCoreConfig(certPath, keyPath);
    fs.writeFileSync(singBoxConfigPath, JSON.stringify(coreConfig, null, 2));

    // 8. 构造服务并启动
    services = [];

    services.push(createService(LIB.core.alias, coreLib, 'StartSingBox', 'StopSingBox', corePayload()));

    if (tunnelLib) {
      const payload = tunnelPayload();
      if (payload) {
        services.push(createService(LIB.tunnel.alias, tunnelLib, 'StartCloudflared', 'StopCloudflared', payload));
      }
    }

    // 信号监听由模块级 stopSbx 统一处理 (services 为模块级变量)

    services.forEach(service => service.start());
    await new Promise(r => setTimeout(r, 1000));
    log(`${LIB.core.alias} is running`);
    if (tunnelLib) log(`${LIB.tunnel.alias} is running`);

    // 9. 等待并检测隧道域名
    await new Promise(r => setTimeout(r, 5000));
    const argoDomain = await extractDomain();

    // 10. 生成节点链接
    currentSubTxt = await generateLinks(argoDomain);

    // 11. 推送 / 上传 / 保活
    await sendTelegram();
    await uploadNodes();
    await addVisitTask();

    // 12. 延迟清理临时文件 (保留订阅)
    setTimeout(() => {
      cleanupFiles({ keepSub: true });
    }, 45000);

    coreState = 'running';
    return { subTxt: currentSubTxt, argoDomain };
  } catch (err) {
    log(`Native service init failed: ${err.message}`);
    started = false;
    coreState = 'stopped';
    throw err;
  }
}

/** 停止全部原生服务 */
async function stopSbx() {
  for (let i = (services || []).length - 1; i >= 0; i--) {
    try { await services[i].stop(); } catch (e) { }
  }
  started = false;
  coreState = 'stopped';
}

/**
 * 核心服务状态: 'stopped' | 'starting' | 'running'
 * 供面板查询, 状态文案由调用方翻译
 */
function coreStatus() {
  return coreState;
}

/**
 * 复位 started 占位标记
 * 启动中途失败(如下载中断)会留下 started=true, 不复位则无法再次开始
 */
function resetCore() {
  started = false;
  coreState = 'stopped';
}

/** 获取当前订阅内容 (base64) */
function getSubBase64() {
  if (currentSubTxt) return Buffer.from(currentSubTxt).toString('base64');
  try { return fs.readFileSync(subPath, 'utf-8'); } catch { return ''; }
}

/** 是否已启动 */
function isSbxRunning() {
  return started;
}

/**
 * 环境变量开关: 是否启用原生核心服务
 * CORE_ENABLED=false 时不自动启动, 只能通过面板手动开启
 * 与代理端口变量无关 —— 端口全留空时即使开关为 true 也没有可用节点
 */
function isCoreEnabled() {
  return String(process.env.CORE_ENABLED ?? 'true').toLowerCase() !== 'false';
}

module.exports = {
  startSbx,
  stopSbx,
  getSubBase64,
  isSbxRunning,
  coreStatus,
  resetCore,
  isCoreEnabled,
  subscribePath,
  SUB_PATH
};
